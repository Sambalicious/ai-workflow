{
  "name": "ai-workflow",
  "version": "1.0.0",
  "description": "Full AI startup team — agents, skills, and pipeline orchestrator for any project",
  "keywords": [
    "ai",
    "agents",
    "skills",
    "claude",
    "cursor",
    "llm",
    "startup",
    "team"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "software-factory": "factory/cli.mjs"
  },
  "files": [
    "factory/",
    ".agents/",
    ".claude/",
    "AGENTS.md",
    "install.sh",
    "skills-lock.json"
  ],
  "scripts": {
    "test": "node --test factory/*.test.mjs factory/adapters/*/*.test.mjs scripts/agents/*.test.mjs .agents/skills/skills.test.mjs",
    "factory": "node factory/cli.mjs",
    "agents:sync": "node scripts/agents/sync.mjs",
    "agents:check": "node scripts/agents/sync.mjs --check"
  }
}
